# Copy to .env for local development. NEVER commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Neon: pooled URL for the app, direct URL for migrations
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/fitcv?sslmode=require
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/fitcv?sslmode=require

# Comma-separated list of allowed browser origins (the web app)
WEB_ORIGIN=http://localhost:3000

# Google Identity Services — OAuth 2.0 Web Client ID (public value)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# AI provider: "anthropic" or "gemini"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Per-user AI calls per rolling 24h (cost control / future paid plans)
AI_DAILY_LIMIT=30
# Hops of trusted reverse proxies in front of the API (Vercel -> Render = 2)
TRUST_PROXY_HOPS=2
SESSION_TTL_DAYS=30
